{
  "name": "MassBank Export API (Podman)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu26.04",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "25",
      "jdkDistro": "tem",
      "installMaven": true,
      "mavenVersion": "3.9.12"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/eitsupi/devcontainer-features/jq-likes:2": {},
    "./features/postgresql": {
      "version": "17"
    }
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/MassBank-export-api,type=bind",
  "workspaceFolder": "/workspaces/MassBank-export-api",
  "remoteUser": "vscode",
  "containerUser": "vscode",
  "updateRemoteUserUID": false,
  "init": true,
  "runArgs": [
    "--userns=keep-id:uid=1000,gid=1000",
    "--security-opt=label=disable",
    "--publish=127.0.0.1:8080:8080"
  ],
  "mounts": [
    "source=maven-repo,target=/home/vscode/.m2,type=volume",
    "source=${localEnv:XDG_RUNTIME_DIR}/podman/podman.sock,target=/run/podman/podman.sock,type=bind",
    "source=codex-devcontainer,target=/home/vscode/.codex,type=volume",
    "source=copilot-devcontainer,target=/home/vscode/.copilot,type=volume",
    "source=copilot-auth-devcontainer,target=/home/vscode/.config/github-copilot,type=volume",
    "source=${localWorkspaceFolder}/../MassBank-data,target=/workspaces/MassBank-data,type=bind",
    "source=${localWorkspaceFolder}/../MassBank-lib,target=/workspaces/MassBank-lib,type=bind"
  ],
  "containerEnv": {
    "DB_HOST": "127.0.0.1",
    "DB_USER": "massbank3",
    "DB_PASSWORD": "massbank3password",
    "DB_NAME": "records",
    "MB_DATA_DIRECTORY": "/workspaces/MassBank-data",
    "DOCKER_HOST": "unix:///run/podman/podman.sock",
    "TESTCONTAINERS_HOST_OVERRIDE": "host.containers.internal",
    "TESTCONTAINERS_RYUK_DISABLED": "true"
  },
  "postCreateCommand": "mvn -B compile",
  "postStartCommand": "curl -fsS --unix-socket /run/podman/podman.sock http://localhost/_ping",
  "waitFor": "postStartCommand"
}

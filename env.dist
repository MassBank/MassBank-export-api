# ----------------------
# Database configuration
# ----------------------

# The published PostgreSQL port on the host (Compose services use 5432)
DB_PORT=5432

# The database user name
DB_USER=massbank3

# The database password
DB_PASSWORD=massbank3password

# The name of the database
DB_NAME=records

# The location of the MassBank-data folder
MB_DATA_DIRECTORY="./MassBank-data"

# REST API settings
CONTEXT_PATH=/
CORS_ALLOWED_ORIGINS=*